{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  // The store's worker file is checked on its own, with the worker's lib (tsconfig.worker.json).
  "exclude": ["src/features/player/store.worker.ts"]
}
