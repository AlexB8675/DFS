{
  "name": "@dfs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "dfs": "node --env-file-if-exists=../../.env src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check:end-to-end": "node --env-file-if-exists=../../.env src/scripts/end-to-end.ts"
  },
  "dependencies": {
    "@dfs/config": "workspace:*",
    "@dfs/crypto": "workspace:*",
    "@dfs/db": "workspace:*",
    "@dfs/shared": "workspace:*",
    "@dfs/storage": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dfs/bot": "workspace:*",
    "@dfs/contract": "workspace:*",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "vitest": "^5.0.3"
  }
