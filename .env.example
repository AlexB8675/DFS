# Settings for `pnpm dev` (DESIGN.md §15). Copy this file to `.env`, which git
# ignores. Every line is optional in development: the defaults match
# docker/docker-compose.dev.yml and keep files under ./.data. Production sets
# its own values and has no defaults for the secrets.

# PostgreSQL from `pnpm db:up`.
# DATABASE_URL=postgres://dfs:dfs@localhost:5432/dfs

# Where files go. `local` keeps blobs under ./.data/blobs, with no Discord.
# BLOB_STORE=local

# Discord, from M1 on. Development uses its own category and no gateway (D25),
# so it never touches production's channels. Never commit the token.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_CATEGORY_NAME=DFS Dev
# DISCORD_GATEWAY=off

# api ↔ bot. Any value works in development; production needs 32+ random characters.
# INTERNAL_RPC_SECRET=

# fatal, error, warn, info, debug, trace or silent.
# LOG_LEVEL=info
