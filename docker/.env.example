# Production settings for docker-compose.yml (DESIGN.md §15), copied to
# docker/.env on the server, which git ignores. No secrets here: those are
# files in DFS_SECRETS (docs/DEPLOY.md).

# The name DFS answers on: HTTPS, share links and the sign-in Origin check.
DFS_DOMAIN=dfs.example.com
DFS_SECRETS=/etc/dfs/secrets

# The Discord server; the bot keeps to its DFS category there (§4).
DISCORD_GUILD_ID=

# What uploads may hold on disk before Discord, and the frame cache. With the
# database, the images and the system, they must fit on the disk.
STAGING_MAX_BYTES=30GiB
CACHE_MAX_BYTES=15GiB
