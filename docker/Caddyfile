# The edge (DESIGN.md §3.2): HTTPS for DFS_DOMAIN, with a certificate Caddy
# gets and renews itself. Only /api/* reaches a service, the API; /internal/*
# and metrics paths are a 404; everything else is the web app, whose routes
# (such as /s/:token) all fall back to index.html.

{
	servers {
		# No HTTP/3 (QUIC, over UDP): a phone with 100 Mbit/s to the internet
		# took 2–8 Mbit/s from here over it, 22 ms away, and 30–70 over
		# HTTP/2 from the same network (2026-10-09). Some networks hold UDP far
		# below TCP, and a browser offered HTTP/3 keeps to it however slow it
		# is. HTTP/2 serves downloads and uploads as well.
		protocols h1 h2
	}
}

{$DFS_DOMAIN} {
	@blocked path /internal /internal/* /metrics /metrics/*
	handle @blocked {
		respond 404
	}

	handle /api/* {
		# One upload part (a chunk, just under the 20 MiB attachment limit),
		# and headroom (§6.1); a test in packages/config checks it. A file
		# streamed whole is as large as the file: the API checks its length
		# against the upload.
		@bounded not path_regexp ^/api/uploads/[^/]+/content$
		request_body @bounded {
			max_size 22MiB
		}
		# Bodies stream both ways, unbuffered: uploaded files, downloads,
		# archives and live events. Only the API's JSON answers are
		# compressed (listings, the admin's figures): a download keeps the
		# length its progress is shown by, and its bytes rarely shrink.
		@answers not path_regexp ^/api/(files/[^/]+/content|archive/[^/]+|s/[^/]+/(files/[^/]+/content|archive))$
		encode @answers zstd gzip {
			match {
				header Content-Type application/json*
			}
		}
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	# Built assets carry their hash in their name, so each is the same file
	# for good. One a page from an older deploy asks for is gone: a 404, which
	# the page takes as its cue to reload (apps/web/src/lib/version-check.ts),
	# never the app's HTML in its place, kept for a year.
	handle /assets/* {
		root * /srv
		encode zstd gzip
		@built file
		header @built Cache-Control "public, max-age=31536000, immutable"
		@gone not file
		header @gone Cache-Control "no-store"
		file_server
	}

	# The app itself is never stored, so even a page restored from the
	# browser's history loads the version deployed now.
	handle {
		root * /srv
		encode zstd gzip
		header Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		# Scripts and styles from DFS itself, and the inline theme script of
		# apps/web/index.html by its hash (a test checks it). Libraries add
		# <style> tags as they run, hence inline styles. No eval: Zod tries it
		# once per page, is refused, and validates without it.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-l55eKp0ym+pjMOspknSgoZBSliGiNPiJae4CTpa2RN4='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
